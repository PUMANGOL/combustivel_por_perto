# ============================================================
#  Combustível por Perto · versão 5.0
#  Mude apenas o que está depois do sinal =
# ============================================================

# 1) Chave secreta das sessões (obrigatória).
#    Gere-a na janela preta com:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#    e cole o resultado a seguir ao =
JWT_SECRET=

# --- Portal (pode deixar como está) ---
PORT=3000
# Onde ficam as confirmações, contas e decisões do portal
DADOS_FICHEIRO=dados/via-abastece.sqlite
# false enquanto usa http://localhost. Em produção, com HTTPS: true
COOKIE_SECURE=false
# loopback: confia no endereço do visitante indicado por um proxy no mesmo computador
# (Cloudflare Tunnel, Nginx ou IIS locais). Proxy noutra máquina: 1. Sem proxy nenhum: 0
TRUST_PROXY=loopback
# Em produção, atrás do proxy: 127.0.0.1 (o portal só aceita ligações do próprio servidor).
# Vazio: aceita ligações de toda a rede (útil para testar com telemóveis na mesma Wi-Fi).
HOST=

# Máximo de escritas por minuto vindas do mesmo endereço IP (protecção contra abusos)
LIMITE_ESCRITAS_MIN=120
