# Combustível por Perto — serviço systemd (Linux)
# Copiar para /etc/systemd/system/combustivel-por-perto.service
[Unit]
Description=Combustivel por Perto (Pumangol)
After=network-online.target
Wants=network-online.target

[Service]
User=cpp
Group=cpp
WorkingDirectory=/opt/combustivel-por-perto
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/combustivel-por-perto/dados /opt/combustivel-por-perto/copias /opt/combustivel-por-perto/.env

[Install]
WantedBy=multi-user.target
