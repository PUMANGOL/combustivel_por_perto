<?xml version="1.0" encoding="UTF-8"?>
<!-- Combustível por Perto — IIS como proxy inverso (requer URL Rewrite e Application Request Routing).
     Colocar no site combustivel.por.perto.pumangol.co.ao, com o certificado TLS associado à ligação HTTPS 443.
     No ARR (nível do servidor): activar «Enable proxy»; «Response buffer threshold (KB)» = 0;
     «Time-out (seconds)» = 3600, para as ligações de tempo real (/api/eventos). -->
<!-- Os cabeçalhos de segurança (CSP, HSTS, etc.) são enviados pelo próprio portal: não os repita no IIS. -->
<configuration>
  <system.webServer>
    <rewrite>
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>
      <rules>
        <rule name="Forçar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="^OFF$" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="VIA Abastece" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables><set name="HTTP_X_FORWARDED_PROTO" value="https" /></serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
